FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/media-api ./cmd/media-api
COPY downloader ./downloader
COPY ffmpeg ./ffmpeg
COPY filemanager ./filemanager
COPY mediajobs ./mediajobs
RUN go test ./cmd/media-api ./downloader ./ffmpeg ./filemanager ./mediajobs \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/media-api ./cmd/media-api

FROM python:3.13-alpine
COPY wheels/ /opt/wheels/
ARG YTDLP_OFFLINE=0
RUN apk add --no-cache ffmpeg ca-certificates nodejs \
    && if [ "$YTDLP_OFFLINE" = "1" ]; then \
         pip install --no-cache-dir --no-index --find-links=/opt/wheels 'yt-dlp[default]'; \
       else pip install --no-cache-dir 'yt-dlp[default]'; fi
RUN addgroup -S -g 10001 media && adduser -S -u 10001 -G media media
WORKDIR /app
COPY --from=build /out/media-api /app/media-api
RUN mkdir -p /tmp/nexora-media && chown -R media:media /tmp/nexora-media
USER media
ENV PORT=8091 MEDIA_TEMP_DIR=/tmp/nexora-media
EXPOSE 8091
ENTRYPOINT ["/app/media-api"]
