import axios from "axios";
import { isIP } from "node:net";
import { EmbedBuilder, PermissionFlagsBits, SlashCommandBuilder } from "discord.js";

const LAPI_URL = (process.env.CROWDSEC_LAPI_URL || "").replace(/\/+$/, "");
const MACHINE_USER = (process.env.CROWDSEC_MACHINE_USER || "").trim();
const MACHINE_PASSWORD = (process.env.CROWDSEC_MACHINE_PASSWORD || "").trim();
const DURATION_PATTERN = /^(\d+(?:\.\d+)?(ms|s|m|h|d|w))+$/i;
const PERMANENT_DURATION = "876000h";
const PERMANENT_THRESHOLD_SECONDS = 50 * 365 * 24 * 60 * 60;

type CrowdSecDecision = {
  duration?: string;
  origin?: string;
  scenario?: string;
  value?: string;
};

const scenarioLabels: Record<string, string> = {
  "crowdsecurity/ssh-bruteforce": "ยิงรหัสผ่าน SSH รัว ๆ",
  "crowdsecurity/ssh-bf": "ยิงรหัสผ่าน SSH รัว ๆ",
  "crowdsecurity/ssh-slow-bf": "ยิงรหัสผ่าน SSH แบบเงียบ ๆ",
  "crowdsecurity/http-probing": "รื้อค้นหน้าเว็บทีละ URL",
  "crowdsecurity/http-sensitive-files": "พยายามดึงไฟล์ลับ (.env, คอนฟิก)",
  "crowdsecurity/http-admin-interface-probing": "เดาทางเข้าหน้าแอดมิน",
  "crowdsecurity/http-bad-user-agent": "บอทปลอมตัวผิดปกติ",
  "crowdsecurity/mysql-bf": "ยิงรหัสผ่านฐานข้อมูล",
  "discord-bot-probe": "แบนโดยผู้ดูแล",
  manual: "แบนโดยผู้ดูแล",
};

let accessToken = "";
let accessTokenExpiresAt = 0;
let decisionCache: { expiresAt: number; items: CrowdSecDecision[] } = { expiresAt: 0, items: [] };

export const crowdSecCommand = new SlashCommandBuilder()
  .setName("crowdsec")
  .setDescription("จัดการ IP ที่ถูกบล็อกในเซิร์ฟเวอร์")
  .setDefaultMemberPermissions(PermissionFlagsBits.Administrator)
  .addSubcommand((sub) =>
    sub
      .setName("bans")
      .setDescription("ดู IP ที่เซิร์ฟเวอร์บล็อกอยู่")
      .addIntegerOption((opt) =>
        opt.setName("limit").setDescription("จำนวน IP ที่ต้องการแสดง (สูงสุด 25)").setMinValue(1).setMaxValue(25)
      )
  )
  .addSubcommand((sub) =>
    sub
      .setName("unban")
      .setDescription("อนุญาตให้ IP เชื่อมต่ออีกครั้ง")
      .addStringOption((opt) =>
        opt.setName("ip").setDescription("IP ที่ต้องการปลดบล็อก เช่น 1.2.3.4").setRequired(true).setAutocomplete(true)
      )
  )
  .addSubcommand((sub) =>
    sub
      .setName("ban")
      .setDescription("บล็อก IP ชั่วคราว")
      .addStringOption((opt) => opt.setName("ip").setDescription("IP ที่ต้องการบล็อก เช่น 1.2.3.4").setRequired(true))
      .addStringOption((opt) =>
        opt.setName("duration").setDescription("เช่น 30m, 4h, 1d หรือ 1w เว้นว่างเพื่อบล็อกถาวร")
      )
      .addStringOption((opt) => opt.setName("reason").setDescription("เหตุผลที่บล็อก (ไม่บังคับ)").setMaxLength(200))
  );

export function crowdSecConfigured(): boolean {
  return Boolean(LAPI_URL && MACHINE_USER && MACHINE_PASSWORD);
}

async function authHeaders(forceRefresh = false): Promise<Record<string, string>> {
  if (forceRefresh || !accessToken || Date.now() > accessTokenExpiresAt) {
    const response = await axios.post(
      `${LAPI_URL}/v1/watchers/login`,
      { machine_id: MACHINE_USER, password: MACHINE_PASSWORD },
      { timeout: 8000 }
    );
    accessToken = String(response.data?.token || "");
    if (!accessToken) throw new Error("LAPI login ไม่สำเร็จ");
    accessTokenExpiresAt = Date.now() + 45 * 60 * 1000;
  }
  return { Authorization: `Bearer ${accessToken}`, "Content-Type": "application/json" };
}

async function request(method: string, path: string, data?: unknown): Promise<any> {
  const url = `${LAPI_URL}${path}`;
  let headers = await authHeaders();
  try {
    return (await axios.request({ method, url, headers, data, timeout: 30000 })).data;
  } catch (error: any) {
    if (error?.response?.status !== 401) throw error;
    headers = await authHeaders(true);
    return (await axios.request({ method, url, headers, data, timeout: 30000 })).data;
  }
}

function durationToSeconds(text: string): number {
  let total = 0;
  const pattern = /(\d+(?:\.\d+)?)(ms|mo|s|m|h|d|w)/gi;
  let match: RegExpExecArray | null;
  while ((match = pattern.exec(text))) {
    const value = parseFloat(match[1]);
    const unit = match[2].toLowerCase();
    if (unit === "ms") total += value / 1000;
    else if (unit === "s") total += value;
    else if (unit === "m") total += value * 60;
    else if (unit === "h") total += value * 3600;
    else if (unit === "d") total += value * 86400;
    else if (unit === "w") total += value * 604800;
    else if (unit === "mo") total += value * 2592000;
  }
  return Math.round(total);
}

function friendlyDuration(seconds: number): string {
  if (seconds < 60) return `${seconds} วินาที`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes} นาที`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return minutes % 60 ? `${hours} ชม. ${minutes % 60} นาที` : `${hours} ชม.`;
  const days = Math.floor(hours / 24);
  return hours % 24 ? `${days} วัน ${hours % 24} ชม.` : `${days} วัน`;
}

function friendlyDecisionDuration(duration: string): string {
  const seconds = durationToSeconds(duration);
  return seconds >= PERMANENT_THRESHOLD_SECONDS ? "ถาวร" : friendlyDuration(seconds);
}

function friendlyScenario(scenario: string): string {
  if (/^discord-bot manual ban by\b/i.test(scenario) || scenario.startsWith("บล็อกผ่าน Discord โดย")) {
    return "ผู้ดูแลบล็อกด้วยตนเอง";
  }
  if (scenarioLabels[scenario]) return scenarioLabels[scenario];
  const short = scenario.replace(/^crowdsecurity\//, "");
  if (short.includes("cve")) return "ลองยิงช่องโหว่โปรแกรม";
  if (short.includes("ssh")) return "แหย่ SSH";
  if (short.includes("http")) return "แหย่เว็บ";
  return short || "พฤติกรรมน่าสงสัย";
}

function isValidIp(value: string): boolean {
  return isIP(value) !== 0;
}

function notice(title: string, description: string) {
  return new EmbedBuilder().setTitle(title).setDescription(description).setColor(0xf59e0b);
}

function clearDecisionCache() {
  decisionCache.expiresAt = 0;
}

export async function activeLocalDecisions(forceRefresh = false): Promise<CrowdSecDecision[]> {
  if (!forceRefresh && Date.now() < decisionCache.expiresAt) return decisionCache.items;
  const alerts = await request("get", "/v1/alerts?has_active_decision=true&include_capi=false&limit=100");
  const byIp = new Map<string, CrowdSecDecision>();
  for (const alert of alerts || []) {
    for (const decision of alert.decisions || []) {
      const origin = String(decision.origin || "").toLowerCase();
      const ip = String(decision.value || "");
      if ((origin === "crowdsec" || origin === "cscli") && ip && !byIp.has(ip)) byIp.set(ip, decision);
    }
  }
  const items = Array.from(byIp.values()).sort(
    (a, b) => durationToSeconds(String(a.duration || "")) - durationToSeconds(String(b.duration || ""))
  );
  decisionCache = { expiresAt: Date.now() + 60000, items };
  return items;
}

export async function refreshCrowdSecCache(): Promise<void> {
  await activeLocalDecisions(true);
}

export async function handleCrowdSecAutocomplete(interaction: any, isAdmin: boolean): Promise<boolean> {
  if (interaction.commandName !== "crowdsec" || interaction.options.getSubcommand(false) !== "unban") return false;
  if (!isAdmin || !crowdSecConfigured()) {
    await interaction.respond([]);
    return true;
  }
  try {
    const query = String(interaction.options.getFocused() || "").trim().toLowerCase();
    const choices = (await activeLocalDecisions())
      .filter((decision) => {
        const ip = String(decision.value || "").toLowerCase();
        const reason = friendlyScenario(String(decision.scenario || "")).toLowerCase();
        return !query || ip.includes(query) || reason.includes(query);
      })
      .slice(0, 25)
      .map((decision) => {
        const ip = String(decision.value || "");
        const reason = friendlyScenario(String(decision.scenario || "")).replace(/[\r\n\t]+/g, " ").replace(/\s+/g, " ").trim();
        return { name: `${ip} · ${reason}`.slice(0, 100), value: ip };
      });
    await interaction.respond(choices);
  } catch (error: any) {
    console.error("[ERROR] CrowdSec autocomplete:", error?.message || error);
    if (!interaction.responded) await interaction.respond([]);
  }
  return true;
}

export async function handleCrowdSecCommand(interaction: any): Promise<void> {
  if (!crowdSecConfigured()) {
    await interaction.editReply({ embeds: [notice("ยังไม่ได้ตั้งค่า CrowdSec", "ให้ผู้ดูแลตั้งค่าการเชื่อมต่อบนเซิร์ฟเวอร์ก่อนใช้เมนูนี้")] });
    return;
  }
  const sub = interaction.options.getSubcommand();
  try {
    if (sub === "bans") {
      const limit = Math.min(Math.max(interaction.options.getInteger("limit") || 6, 1), 25);
      const all = await activeLocalDecisions();
      interaction.recordBotActivity?.({ outcome: "success", result: `ตรวจสอบแล้ว พบ ${all.length} IP ที่ยังถูกบล็อก` });
      if (!all.length) {
        await interaction.editReply({ embeds: [new EmbedBuilder().setTitle("ไม่มี IP ที่ถูกบล็อก").setColor(0x22c55e).setDescription("ตอนนี้เซิร์ฟเวอร์ไม่มีรายการบล็อกที่ยังมีผล").setFooter({ text: "แสดงเฉพาะรายการของเซิร์ฟเวอร์นี้" }).setTimestamp()] });
        return;
      }
      const visible = all.slice(0, limit);
      await interaction.editReply({ embeds: [new EmbedBuilder()
        .setTitle("IP ที่เซิร์ฟเวอร์บล็อกอยู่")
        .setColor(0xef4444)
        .setDescription(`กำลังบล็อกทั้งหมด **${all.length} IP** จากเว็บไซต์และ SSH`)
        .addFields(visible.map((item, index) => {
          const remaining = friendlyDecisionDuration(String(item.duration || ""));
          return { name: `${index + 1}. ${String(item.value || "ไม่ทราบ IP")}`, value: `**เหตุผล:** ${friendlyScenario(String(item.scenario || ""))}\n**ระยะเวลา:** ${remaining === "ถาวร" ? "ถาวร" : `เหลือ ${remaining}`}` };
        }))
        .setFooter({ text: `แสดง ${visible.length} จาก ${all.length} รายการ · เรียงตามเวลาที่จะหมดก่อน` })
        .setTimestamp()] });
      return;
    }

    const ip = (interaction.options.getString("ip") || "").trim();
    if (!isValidIp(ip)) {
      await interaction.editReply({ embeds: [notice("ตรวจสอบ IP อีกครั้ง", "กรอกเป็น IPv4 หรือ IPv6 เช่น `1.2.3.4`")] });
      return;
    }
    if (sub === "unban") {
      const count = Number((await request("delete", `/v1/decisions?ip=${encodeURIComponent(ip)}`))?.nbDeleted || 0);
      interaction.recordBotActivity?.({ outcome: count > 0 ? "success" : "unknown", target: ip, result: count > 0 ? `ยกเลิกรายการบล็อก ${count} รายการแล้ว · ระบบป้องกันอัปเดตภายในประมาณ 15 วินาที` : "ไม่พบรายการบล็อกที่ยกเลิกได้ จึงไม่มีการเปลี่ยนแปลง" });
      clearDecisionCache();
      const embed = count > 0
        ? new EmbedBuilder().setTitle("ปลดบล็อกแล้ว").setColor(0x22c55e).setDescription(`\`${ip}\` กลับมาเชื่อมต่อได้ตามปกติ`).addFields({ name: "รายการที่ยกเลิก", value: `${count} รายการ`, inline: true }).setFooter({ text: "การเปลี่ยนแปลงมีผลภายในประมาณ 15 วินาที" }).setTimestamp()
        : new EmbedBuilder().setTitle("ไม่พบ IP นี้").setColor(0xf59e0b).setDescription(`\`${ip}\` ไม่ได้อยู่ในรายการบล็อกของเซิร์ฟเวอร์`).setFooter({ text: "ตรวจสอบรายการได้จาก /crowdsec bans" });
      await interaction.editReply({ embeds: [embed] });
      return;
    }
    if (sub === "ban") {
      const durationInput = (interaction.options.getString("duration") || "").trim();
      const isPermanent = !durationInput;
      const duration = isPermanent ? PERMANENT_DURATION : durationInput;
      const reason = (interaction.options.getString("reason") || "").trim() || "ผู้ดูแลบล็อกด้วยตนเอง";
      if (!isPermanent && (!DURATION_PATTERN.test(duration) || durationToSeconds(duration) < 1)) {
        await interaction.editReply({ embeds: [notice("ตรวจสอบระยะเวลาอีกครั้ง", "ใช้รูปแบบ `30m`, `4h`, `1d` หรือ `1w`")] });
        return;
      }
      const now = new Date().toISOString();
      await request("post", "/v1/alerts", [{
        machine_id: MACHINE_USER, scenario: "manual", scenario_version: "0.1", scenario_hash: "manual", message: reason,
        events: [], events_count: 1, start_at: now, stop_at: now, capacity: 1, leakspeed: "0", simulated: false,
        source: { scope: "Ip", value: ip, ip, as_num: 0, as_name: "", cn: "", lat: 0, lon: 0 },
        decisions: [{ duration, scenario: reason, origin: "cscli", scope: "Ip", type: "ban", value: ip, simulated: false }],
      }]);
      interaction.recordBotActivity?.({ outcome: "success", target: ip, result: "บันทึกรายการบล็อกแล้ว · ระบบป้องกันอัปเดตภายในประมาณ 15 วินาที", details: `ระยะเวลา: ${isPermanent ? "ถาวร" : friendlyDecisionDuration(duration)}\nเหตุผล: ${reason}` });
      clearDecisionCache();
      await interaction.editReply({ embeds: [new EmbedBuilder().setTitle("บล็อก IP แล้ว").setColor(0xef4444).setDescription(`\`${ip}\` จะถูกปฏิเสธการเชื่อมต่อจากเว็บไซต์และ SSH`).addFields(
        { name: "ระยะเวลา", value: isPermanent ? "ถาวร" : friendlyDecisionDuration(duration), inline: true },
        { name: "เหตุผล", value: reason, inline: true }
      ).setFooter({ text: "เริ่มมีผลภายในประมาณ 15 วินาที" }).setTimestamp()] });
    }
  } catch (error: any) {
    console.error("[ERROR] /crowdsec", sub, error?.response?.status || "", error?.message || error);
    await interaction.editReply({ embeds: [notice("เชื่อมต่อ CrowdSec ไม่ได้", "ลองอีกครั้ง หากยังไม่ได้ ให้ผู้ดูแลตรวจสอบ CrowdSec บนเซิร์ฟเวอร์")] });
  }
}
