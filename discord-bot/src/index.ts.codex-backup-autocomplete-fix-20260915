        await beginPrivateReply(interaction);
        if (!interaction.guild) {
          await interaction.editReply("คำสั่งนี้สามารถใช้ได้เฉพาะภายในห้องเซิร์ฟเวอร์ Discord เท่านั้น");
          return;
        }

        try {
          // Fetch guild members
          let members: any;
          try {
            members = await interaction.guild.members.fetch();
          } catch {
            members = interaction.guild.members.cache;
          }

          // Fetch current mappings to see which ones are not bound
          const mapRes = await axios.get(`${API_URL}/api/internal/bot/student-mappings`, {
            headers: actorHeaders,
            timeout: 10000,
          });
          const items = mapRes.data?.items || [];
          const unboundCodes = items
            .filter((it: any) => !it.discordUserId)
            .map((it: any) => String(it.studentCode));

          const batchToBind: { studentCode: string; discordUserId: string; discordUsername: string }[] = [];

          for (const [_, member] of members) {
            if (member.user.bot) continue;
            const detected = detectStudentCodeFromMember(member, member.user, new Set(unboundCodes));
            if (detected) {
              batchToBind.push({
                studentCode: detected,
                discordUserId: member.user.id,
                discordUsername: member.user.tag || member.user.username,
              });
              const idx = unboundCodes.indexOf(detected);
              if (idx >= 0) unboundCodes.splice(idx, 1);
            }
          }

          if (batchToBind.length === 0) {
            await interaction.editReply("สแกนสมาชิกเรียบร้อยแล้ว ไม่พบสมาชิกใหม่ที่มีรหัส 3 ตัวท้ายตรงกับฐานข้อมูลที่ยังไม่ถูกผูก");
            return;
          }

          const bindRes = await axios.post(
            `${API_URL}/api/internal/bot/student-mappings/batch-bind`,
            { mappings: batchToBind },
            {
              headers: actorHeaders,
              timeout: 10000,
            }
          );

          await refreshLocalCache();

          const count = bindRes.data?.boundCount || batchToBind.length;
          const summary = batchToBind.map((b) => `• รหัส **${b.studentCode}** -> @${b.discordUsername}`).join("\n");
          await interaction.editReply({
            content: `ตรวจจับและผูกบัญชี Discord จากชื่อสมาชิกสำเร็จ ${count} คน:\n${summary}`,
          });
        } catch (err: any) {
          await interaction.editReply({
            content: "สแกนสมาชิกไม่สำเร็จ ลองใหม่อีกครั้ง",
          });
        }
        return;
      }
    }

    // Command: /crowdsec (admin only) — จัดการแบน/ปลดแบน IP ของ CrowdSec
    if (commandName === "crowdsec") {
      if (!isAdmin) {
        await replyPrivilegedOnly(interaction);
        return;
      }
      await beginPrivateReply(interaction);

      if (!crowdsecConfigured()) {
        await interaction.editReply({ embeds: [
          userNoticeEmbed("ระบบความปลอดภัยยังไม่พร้อม", "การเชื่อมต่อ CrowdSec ยังไม่ได้ตั้งค่า กรุณาตรวจสอบค่าระบบบนเซิร์ฟเวอร์")
        ] });
        return;
      }

      const sub = interaction.options.getSubcommand();

      try {
        if (sub === "bans") {
          const limit = Math.min(Math.max(interaction.options.getInteger("limit") || 6, 1), 25);
          const all = await activeLocalCrowdSecDecisions();
          if (all.length === 0) {
            const calm = new EmbedBuilder()
              .setTitle("ไม่มี IP ที่ถูกบล็อก")
              .setColor(0x22c55e)
              .setDescription("ตอนนี้เซิร์ฟเวอร์ไม่มีรายการบล็อกที่ยังมีผล")
              .setFooter({ text: "แสดงเฉพาะรายการของเซิร์ฟเวอร์นี้" })
              .setTimestamp(new Date());
            await interaction.editReply({ embeds: [calm] });
            return;
          }
          const local = all.sort(
            (a, b) => durationToSeconds(String(a.duration || "")) - durationToSeconds(String(b.duration || ""))
          );
          const visible = local.slice(0, limit);
          const fields = visible.map((d, index) => {
            const remaining = friendlyDecisionDuration(String(d.duration || ""));
            const durationLabel = remaining === "ถาวร" ? "ถาวร" : `เหลือ ${remaining}`;
            return {
              name: `${index + 1}. ${String(d.value || "ไม่ทราบ IP")}`,
              value: `**เหตุผล:** ${friendlyScenario(String(d.scenario || ""))}\n**ระยะเวลา:** ${durationLabel}`,
              inline: false,
            };
          });

          const bansEmbed = new EmbedBuilder()
            .setTitle("IP ที่เซิร์ฟเวอร์บล็อกอยู่")
            .setColor(0xef4444)
            .setDescription(`กำลังบล็อกทั้งหมด **${all.length} IP** จากเว็บไซต์และ SSH`)
            .addFields(fields)
            .setFooter({ text: `แสดง ${visible.length} จาก ${all.length} รายการ · เรียงตามเวลาที่จะหมดก่อน` })
            .setTimestamp(new Date());
          await interaction.editReply({ embeds: [bansEmbed] });
          return;
        }

        if (sub === "unban") {
          const ip = (interaction.options.getString("ip") || "").trim();
          if (!isValidIpInput(ip)) {
            await interaction.editReply({ embeds: [
              userNoticeEmbed("ตรวจสอบ IP อีกครั้ง", "กรอกเป็น IPv4 หรือ IPv6 เช่น `1.2.3.4`")
            ] });
            return;
          }
          const result = await crowdsecRequest("delete", `/v1/decisions?ip=${encodeURIComponent(ip)}`);
          const count = Number(result?.nbDeleted || 0);
          if (count > 0) {
            clearLocalDecisionCache();
            const embed = new EmbedBuilder()
              .setTitle("ปลดบล็อกแล้ว")
              .setColor(0x22c55e)
              .setDescription(`\`${ip}\` กลับมาเชื่อมต่อได้ตามปกติ`)
              .addFields({ name: "รายการที่ยกเลิก", value: `${count} รายการ`, inline: true })
              .setFooter({ text: "การเปลี่ยนแปลงมีผลภายในประมาณ 15 วินาที" })
              .setTimestamp(new Date());
            await interaction.editReply({ embeds: [embed] });
          } else {
            const embed = new EmbedBuilder()
              .setTitle("ไม่พบ IP นี้")
              .setColor(0xf59e0b)
              .setDescription(`\`${ip}\` ไม่ได้อยู่ในรายการบล็อกของเซิร์ฟเวอร์`)
              .setFooter({ text: "ตรวจสอบรายการได้จาก /crowdsec bans" });
            await interaction.editReply({ embeds: [embed] });
          }
          return;
        }

        if (sub === "ban") {
          const ip = (interaction.options.getString("ip") || "").trim();
          const durationInput = (interaction.options.getString("duration") || "").trim();
          const isPermanent = durationInput === "";
          const duration = isPermanent ? CROWDSEC_PERMANENT_DURATION : durationInput;
          const reasonInput = (interaction.options.getString("reason") || "").trim();
          const reason = reasonInput || "ผู้ดูแลบล็อกด้วยตนเอง";
          if (!isValidIpInput(ip)) {
            await interaction.editReply({ embeds: [
              userNoticeEmbed("ตรวจสอบ IP อีกครั้ง", "กรอกเป็น IPv4 หรือ IPv6 เช่น `1.2.3.4`")
            ] });
            return;
          }
          if (!isPermanent && !CROWDSEC_DURATION_PATTERN.test(duration)) {
            await interaction.editReply({ embeds: [
              userNoticeEmbed("ตรวจสอบระยะเวลาอีกครั้ง", "ใช้รูปแบบ `30m`, `4h`, `1d` หรือ `1w`")
            ] });
            return;
          }
          const nowIso = new Date().toISOString();
          const payload = [{
            machine_id: CROWDSEC_MACHINE_USER,
            scenario: "manual",
            scenario_version: "0.1",
            scenario_hash: "manual",
            message: reason,
            events: [],
            events_count: 1,
            start_at: nowIso,
            stop_at: nowIso,
            capacity: 1,
            leakspeed: "0",
            simulated: false,
            source: { scope: "Ip", value: ip, ip, as_num: 0, as_name: "", cn: "", lat: 0, lon: 0 },
            decisions: [{ duration, scenario: reason, origin: "cscli", scope: "Ip", type: "ban", value: ip, simulated: false }],
          }];
          await crowdsecRequest("post", "/v1/alerts", payload);
          clearLocalDecisionCache();
          const embed = new EmbedBuilder()
            .setTitle("บล็อก IP แล้ว")
            .setColor(0xef4444)
            .setDescription(`\`${ip}\` จะถูกปฏิเสธการเชื่อมต่อจากเว็บไซต์และ SSH`)
            .addFields(
              { name: "ระยะเวลา", value: isPermanent ? "ถาวร" : friendlyDecisionDuration(duration), inline: true },
              { name: "เหตุผล", value: reason, inline: true }
            )
            .setFooter({ text: "เริ่มมีผลภายในประมาณ 15 วินาที" })
            .setTimestamp(new Date());
          await interaction.editReply({ embeds: [embed] });
          return;
        }
      } catch (err: any) {
        console.error("[ERROR] /crowdsec", sub, "->", err?.code || "", err?.response?.status || "", err?.message || err);
        if (err?.stack) console.error(err.stack.split("\n").slice(0, 4).join("\n"));
        const detail = err?.response?.data?.message || err.message || err?.code || (typeof err === "string" ? err : "") || "ไม่ทราบสาเหตุ";
        console.error("[ERROR] CrowdSec detail:", detail);
        await interaction.editReply({ embeds: [
          userNoticeEmbed("เชื่อมต่อระบบความปลอดภัยไม่ได้", "ลองใหม่อีกครั้ง หากยังพบปัญหาให้ตรวจสอบ CrowdSec บนเซิร์ฟเวอร์")
        ] });
      }
      return;
    }
  }
} catch (fatalErr: any) {
  console.error("[ERROR] Unhandled interaction error:", fatalErr);
  try {
    if (interaction.isRepliable()) {
      if (interaction.deferred || interaction.replied) {
        await sendPrivateReply(interaction, { content: "ทำรายการไม่สำเร็จ ลองใหม่อีกครั้ง" });
      } else {
        await sendPrivateReply(interaction, { content: "ทำรายการไม่สำเร็จ ลองใหม่อีกครั้ง" });
      }
    }
  } catch {}
}
});

// Handle Prefix Commands (!code, !db) in Guilds & Direct Messages (DM) from students
client.on(Events.MessageCreate, async (message) => {
  if (SECURITY_ONLY) return;
  if (message.author.bot) return;

  const rawContent = message.content.trim();
  const lowerContent = rawContent.toLowerCase();

  // 1. Guild Prefix Commands: !code or !db
  if (message.guild) {
    if (lowerContent.startsWith("!code") || lowerContent.startsWith("!db")) {
      const isWorkspace = lowerContent.startsWith("!code");
      const prefix = isWorkspace ? "!code" : "!db";
      const args = rawContent.slice(prefix.length).trim();
      const isAdmin = isPrivilegedDiscordUser(message.author.id, message.guild.ownerId);

      // Immediately delete invocation message in guild to protect student's privacy
      if (message.deletable) {
        try {
          await message.delete();
        } catch {
          // Ignore delete failure if missing permissions
        }
      }

      // Check rate limit
      const rateCheck = checkRateLimit(message.author.id);
      if (!rateCheck.allowed) {
        try {
          await replaceDirectMessage(message.author.id, () => message.author.send(rateLimitPayload(rateCheck.waitSeconds)));
        } catch {
          // Cannot DM user
        }
        return;
      }

      // Resolve student code: from args, or from bound user cache, or from nickname/display name
      let code = "";
      const match = args.match(/\d{2,10}/);
      if (match) {
        code = match[0].length > 3 ? match[0].slice(-3) : match[0];
      } else {
        const bound = boundUsersCache.get(message.author.id);
        if (bound) {
          code = bound;
        } else {
          const detected = detectStudentCodeFromMember(message.member, message.author, validStudentCodes);
          if (detected) {
            code = detected;
          }
        }
      }

      if (!code) {
        let dmSent = false;
        try {
          await replaceDirectMessage(message.author.id, () =>
            message.author.send({
              embeds: [
                new EmbedBuilder()
                  .setTitle("กรอกรหัสของคุณ")
                  .setColor(0x0ea5e9)
                  .setDescription(`พิมพ์ \`${prefix} 123\` หรือส่งรหัส 3 ตัวท้ายมาในแชทนี้`)
                  .setFooter({ text: USER_ONLY_FOOTER }),
              ],
            })
          );
          dmSent = true;
        } catch {
          dmSent = false;
        }

        try {
          const noticeContent = dmSent
            ? `<@${message.author.id}> พิมพ์รหัส 3 ตัวท้ายมาในข้อความส่วนตัวได้เลย`
            : `<@${message.author.id}> พิมพ์ \`${prefix} 123\` หรือใช้ ${isWorkspace ? "/code" : "/db"}`;
          await sendReplaceableNotice(message.channel, message.author.id, noticeContent);
        } catch {}
        return;
      }

      // Fetch ticket
      if (isWorkspace) {
        const result = await fetchStudentWorkspaceTicket(
          code,
          message.author.id,
          message.author.tag || message.author.username,
          isAdmin
        );

        if (!result.ok) {
          try {
            await replaceDirectMessage(message.author.id, () =>
              message.author.send(ticketErrorPayload("workspace", result, code, message.author.id))
            );
          } catch {}
          return;
        }

        if (!isAdmin) {
          boundUsersCache.set(message.author.id, code);
        }
        let dmSent = false;
        try {
          await replaceDirectMessage(message.author.id, () =>
            message.author.send(buildWorkspaceSuccessPayload(result.data))
          );
          dmSent = true;
        } catch {
          dmSent = false;
        }

        try {
          const noticeContent = dmSent
            ? `<@${message.author.id}> ส่งให้ในข้อความส่วนตัวแล้ว`
            : `<@${message.author.id}> เปิดรับข้อความส่วนตัวก่อน หรือใช้ /code`;
          await sendReplaceableNotice(message.channel, message.author.id, noticeContent);
        } catch {}
      } else {
        const result = await fetchStudentTicket(
          code,
          message.author.id,
          message.author.tag || message.author.username,
          isAdmin
        );

        if (!result.ok) {
          try {
            await replaceDirectMessage(message.author.id, () =>
              message.author.send(ticketErrorPayload("db", result, code, message.author.id))
            );
          } catch {}
          return;
        }

        if (!isAdmin) {
          boundUsersCache.set(message.author.id, code);
        }
        let dmSent = false;
        try {
          await replaceDirectMessage(message.author.id, () =>
            message.author.send(buildSuccessPayload(result.data))
          );
          dmSent = true;
        } catch {
          dmSent = false;
        }

        try {
          const noticeContent = dmSent
            ? `<@${message.author.id}> ส่งให้ในข้อความส่วนตัวแล้ว`
            : `<@${message.author.id}> เปิดรับข้อความส่วนตัวก่อน หรือใช้ /db`;
          await sendReplaceableNotice(message.channel, message.author.id, noticeContent);
        } catch {}
      }
      return;
    }
    return; // Ignore other guild messages
  }

  // 2. Direct Messages (DM) handling
  const isWorkspaceDM = lowerContent.startsWith("!code") || lowerContent.startsWith("code");

  // Extract digits
  const match = rawContent.match(/\d{2,10}/);
  if (!match) {
    const guideEmbed = new EmbedBuilder()
      .setTitle("กรอกรหัสของคุณ")
      .setColor(0x0284c7)
      .setDescription("พิมพ์รหัส 3 ตัวท้ายมาในแชทนี้ได้เลย เช่น `123` หรือ `!code 123`")
      .setFooter({ text: USER_ONLY_FOOTER });
    await replaceDirectMessage(message.author.id, () => message.reply({ embeds: [guideEmbed] }));
    return;
  }

  // Rate limit check
  const rateCheck = checkRateLimit(message.author.id);
  if (!rateCheck.allowed) {
    await replaceDirectMessage(message.author.id, () => message.reply(rateLimitPayload(rateCheck.waitSeconds)));
    return;
  }

  let code = match[0];
  if (code.length > 3) {
    code = code.slice(-3);
  }

  const isAdmin = isPrivilegedDiscordUser(message.author.id);

  if (isWorkspaceDM) {
    const result = await fetchStudentWorkspaceTicket(
      code,
      message.author.id,
      message.author.tag || message.author.username,
      isAdmin
    );
    if (!result.ok) {
      await replaceDirectMessage(message.author.id, () =>
        message.reply(ticketErrorPayload("workspace", result, code, message.author.id))
      );
      return;
    }
    if (!isAdmin) {
      boundUsersCache.set(message.author.id, code);
    }
    await replaceDirectMessage(message.author.id, () => message.reply(buildWorkspaceSuccessPayload(result.data)));
  } else {
    const result = await fetchStudentTicket(
      code,
      message.author.id,
      message.author.tag || message.author.username,
      isAdmin
    );
    if (!result.ok) {
      await replaceDirectMessage(message.author.id, () =>
        message.reply(ticketErrorPayload("db", result, code, message.author.id))
      );
      return;
    }
    if (!isAdmin) {
      boundUsersCache.set(message.author.id, code);
    }
    await replaceDirectMessage(message.author.id, () => message.reply(buildSuccessPayload(result.data)));
  }
});

if (TOKEN && !BOT_SECRET) {
  console.error("[FATAL] BOT_INTERNAL_SECRET is required when DISCORD_BOT_TOKEN is configured.");
  process.exitCode = 1;
} else if (TOKEN) {
  client.login(TOKEN).catch((err) => {
    console.error("[FATAL] Discord client login error:", err.message);
  });
} else {
  console.log("[INFO] Discord bot is in standby mode. Add DISCORD_BOT_TOKEN and DISCORD_CLIENT_ID to .env to connect to Discord.");
  setInterval(() => {
    // Keep container alive in standby
  }, 60000);
}
