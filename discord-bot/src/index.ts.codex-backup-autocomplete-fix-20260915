function privilegedDiscordIds(): string[] {
  const raw = process.env.DISCORD_ADMIN_IDS || "";
  return raw.split(",").map((item) => item.trim()).filter((id) => /^[0-9]{17,20}$/.test(id));
}
function isPrivilegedDiscordUser(userId: string, guildOwnerId?: string | null): boolean {
  if (guildOwnerId && userId === guildOwnerId) return true;
  return privilegedDiscordIds().includes(userId);
}

function botHeaders(actorDiscordId?: string) {
  const headers: Record<string, string> = {
    "Content-Type": "application/json",
    "X-Bot-Internal-Secret": BOT_SECRET,
  };
  if (actorDiscordId) {
    headers["X-Bot-Actor-Discord-Id"] = actorDiscordId;
  }
  return headers;
}

// ---------- CrowdSec LAPI ----------
let crowdsecToken = "";
let crowdsecTokenExpireAt = 0;

function crowdsecConfigured(): boolean {
  return Boolean(CROWDSEC_LAPI_URL && CROWDSEC_MACHINE_USER && CROWDSEC_MACHINE_PASSWORD);
}

async function crowdsecAuthHeaders(forceRefresh = false): Promise<Record<string, string>> {
  if (forceRefresh || !crowdsecToken || Date.now() > crowdsecTokenExpireAt) {
    const res = await axios.post(
      `${CROWDSEC_LAPI_URL}/v1/watchers/login`,
      { machine_id: CROWDSEC_MACHINE_USER, password: CROWDSEC_MACHINE_PASSWORD },
      { timeout: 8000 }
    );
    const token = String(res.data?.token || "");
    if (!token) throw new Error("LAPI login ไม่สำเร็จ (ไม่ได้รับ token)");
    crowdsecToken = token;
    crowdsecTokenExpireAt = Date.now() + 45 * 60 * 1000;
  }
  return { Authorization: `Bearer ${crowdsecToken}`, "Content-Type": "application/json" };
}

async function crowdsecRequest(method: string, path: string, data?: unknown): Promise<any> {
  const url = `${CROWDSEC_LAPI_URL}${path}`;
  let headers = await crowdsecAuthHeaders();
  try {
    const res = await axios.request({ method, url, headers, data, timeout: 30000 });
    return res.data;
  } catch (err: any) {
    if (err?.response?.status === 401) {
      headers = await crowdsecAuthHeaders(true);
      const retry = await axios.request({ method, url, headers, data, timeout: 30000 });
      return retry.data;
    }
    throw err;
  }
}

function isValidIpInput(value: string): boolean {
  if (/^(\d{1,3}\.){3}\d{1,3}$/.test(value)) {
    return value.split(".").every((part) => Number(part) <= 255);
  }
  return /^[0-9a-fA-F:]+$/.test(value) && value.includes(":");
}

