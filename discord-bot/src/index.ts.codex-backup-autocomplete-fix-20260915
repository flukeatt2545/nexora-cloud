function friendlyScenario(scenario: string): string {
  if (/^discord-bot manual ban by\b/i.test(scenario) || scenario.startsWith("บล็อกผ่าน Discord โดย")) {
    return "ผู้ดูแลบล็อกด้วยตนเอง";
  }
  if (CROWDSEC_SCENARIO_LABELS[scenario]) return CROWDSEC_SCENARIO_LABELS[scenario];
  const short = scenario.replace(/^crowdsecurity\//, "");
  if (short.includes("cve")) return "ลองยิงช่องโหว่โปรแกรม";
  if (short.includes("ssh")) return "แหย่ SSH";
  if (short.includes("http")) return "แหย่เว็บ";
  return short || "พฤติกรรมน่าสงสัย";
}

function durationToSeconds(text: string): number {
  let total = 0;
  const pattern = /(\d+(?:\.\d+)?)(ms|s|m|h|d|w|mo)/gi;
  let match: RegExpExecArray | null;
  while ((match = pattern.exec(text))) {
    const value = parseFloat(match[1]);
    const unit = match[2].toLowerCase();
    if (unit === "ms") total += value / 1000;
    else if (unit === "s") total += value;
    else if (unit === "m") total += value * 60;
    else if (unit === "h") total += value * 3600;
    else if (unit === "d") total += value * 86400;
    else if (unit === "w") total += value * 604800;
    else if (unit === "mo") total += value * 2592000;
  }
  return Math.round(total);
}

function friendlyDuration(seconds: number): string {
  if (seconds < 60) return `${seconds} วินาที`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes} นาที`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return minutes % 60 ? `${hours} ชม. ${minutes % 60} นาที` : `${hours} ชม.`;
  const days = Math.floor(hours / 24);
  return hours % 24 ? `${days} วัน ${hours % 24} ชม.` : `${days} วัน`;
}

function friendlyDecisionDuration(duration: string): string {
  const seconds = durationToSeconds(duration);
  return seconds >= CROWDSEC_PERMANENT_THRESHOLD_SECONDS ? "ถาวร" : friendlyDuration(seconds);
}

type CrowdSecDecision = {
  duration?: string;
  origin?: string;
  scenario?: string;
  value?: string;
};

let localDecisionCache: { expiresAt: number; items: CrowdSecDecision[] } = { expiresAt: 0, items: [] };

function clearLocalDecisionCache() {
  localDecisionCache.expiresAt = 0;
}

async function activeLocalCrowdSecDecisions(): Promise<CrowdSecDecision[]> {
  if (Date.now() < localDecisionCache.expiresAt) return localDecisionCache.items;

  const alerts = await crowdsecRequest("get", "/v1/alerts?has_active_decision=true&include_capi=false&limit=100");
  const byIp = new Map<string, CrowdSecDecision>();
  for (const alertItem of alerts || []) {
    for (const decision of alertItem.decisions || []) {
      const origin = String(decision.origin || "").toLowerCase();
      if (origin !== "crowdsec" && origin !== "cscli") continue;
      const ip = String(decision.value || "");
      if (ip && !byIp.has(ip)) byIp.set(ip, decision);
    }
  }

  const items = Array.from(byIp.values()).sort(
    (a, b) => durationToSeconds(String(a.duration || "")) - durationToSeconds(String(b.duration || ""))
  );
  localDecisionCache = { expiresAt: Date.now() + 5000, items };
  return items;
}

