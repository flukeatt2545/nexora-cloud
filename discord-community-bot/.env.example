COMMUNITY_DISCORD_BOT_TOKEN=
# The one server this bot looks after. Can also be set (and changed) on the admin Discord bot
# page; the page wins. Left empty everywhere, the bot uses the server it was invited to.
COMMUNITY_DISCORD_GUILD_ID=
# Discord user ids (comma separated) that may always run /setup and /create, besides members
# with Manage Server. Falls back to DISCORD_ADMIN_IDS.
COMMUNITY_DISCORD_ADMIN_IDS=
NEXORA_API_URL=http://localhost:8080
BOT_INTERNAL_SECRET=
PUBLIC_APP_URL=https://nkn02.com
# What the status alerts check. Defaults: PUBLIC_APP_URL and NEXORA_API_URL/health.
COMMUNITY_STATUS_WEB_URL=
COMMUNITY_STATUS_API_URL=
