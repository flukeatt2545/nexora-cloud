APP_ENV=auto
# Optional emergency override. Production always forces Secure cookies.
COOKIE_SECURE=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8088

POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
S3_ACCESS_KEY=nexora
S3_SECRET_KEY=replace-with-a-long-random-minio-password
CLOUDFLARE_API_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MAIL_DISCORD_BOT_TOKEN=
MAIL_DISCORD_CLIENT_ID=
MAIL_DISCORD_GUILD_ID=
# Discord user IDs allowed to bind/unbind mail and view /mail-admin (comma-separated)
MAIL_DISCORD_ADMIN_IDS=
# Bot presence: playing | watching | listening | competing
MAIL_DISCORD_ACTIVITY_TYPE=watching
MAIL_DISCORD_ACTIVITY_TEXT=เมลของคุณ
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEBHOOK_ENCRYPTION_KEY=replace-with-a-long-random-webhook-encryption-key
HOSTING_ENCRYPTION_KEY=replace-with-a-separate-32-byte-or-longer-random-key
TENANT_DB_ROOT_PASSWORD=replace-with-a-different-long-random-mysql-password
PMA_INTERNAL_SECRET=replace-with-a-separate-long-random-internal-secret
PMA_CONTROL_PASSWORD=replace-with-a-separate-long-random-control-password
PMA_PUBLIC_URL=http://db.localhost:8088
PMA_RETURN_URL=http://localhost:8088/admin/hosting

# CheckSlips top-up verification (server-side only)
CHECKSLIPS_API_TOKEN=
CHECKSLIPS_TENANT_ID=
CHECKSLIPS_ENCRYPTION_KEY=replace-with-a-separate-long-random-checkslips-key
CHECKSLIPS_API_BASE_URL=https://api.checkslips.com
TOPUP_RECEIVER_BANK_CODE=
TOPUP_RECEIVER_BANK_NAME=
TOPUP_RECEIVER_ACCOUNT_NUMBER=
TOPUP_RECEIVER_ACCOUNT_NAME=

# Resend domain email (server-side only)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_BASE_URL=https://api.resend.com

# Stalwart Mail Server (server-side only)
STALWART_PUBLIC_URL=https://mail.nkn02.com
STALWART_API_URL=http://stalwart:8080
STALWART_API_TOKEN=
# Format: admin:a-long-random-recovery-password
STALWART_RECOVERY_ADMIN=

# Cloudflare Turnstile: the captcha on the Discord verify page (dash.cloudflare.com > Turnstile).
# Cloudflare's test keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
