FROM golang:alpine AS builder
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY runtime-gateway ./runtime-gateway
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/runtime-gateway ./runtime-gateway

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S -G app app
USER app
COPY --from=builder /out/runtime-gateway /runtime-gateway
EXPOSE 8090
ENTRYPOINT ["/runtime-gateway"]
