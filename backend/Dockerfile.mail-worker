FROM golang:alpine AS builder
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY internal/mailsanitize ./internal/mailsanitize
COPY mail-worker ./mail-worker
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/mail-worker ./mail-worker

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/mail-worker /mail-worker
ENTRYPOINT ["/mail-worker"]
